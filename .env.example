# Порт на хосте, на котором Docker Compose публикует приложение
# (само приложение внутри контейнера всегда слушает 8000 — см. Dockerfile)
APP_PORT=8000

# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Подключение к Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Мастер-ключ шифрования (Fernet). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Время жизни секрета по умолчанию и максимум (в секундах)
DEFAULT_TTL_SECONDS=3600
MAX_TTL_SECONDS=604800

# Максимальный размер загружаемого файла (в мегабайтах)
MAX_FILE_SIZE_MB=20
